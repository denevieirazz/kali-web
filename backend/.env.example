# CloudOS Unified local agent
PORT=18080
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:15173,http://localhost:15173

# Opcional. Quando ausente, um segredo aleatório é criado em data/.jwt-secret.
JWT_SECRET=coloque_aqui_uma_chave_aleatoria_com_pelo_menos_64_caracteres
JWT_EXPIRES_IN=2h

# Diretório do banco JSON atômico e do segredo local.
CLOUDOS_DATA_DIR=../data
DATABASE_PATH=../data/cloudos.json

# Somente para desenvolvimento explícito. Nunca é aceito pelo host nativo.
# NODE_ENV=development
# CLOUDOS_ALLOW_SETUP_RESET=1
