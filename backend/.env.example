# Configurações do Backend CloudOS-Unified
PORT=5000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Defina um segredo forte em produção
JWT_SECRET=coloque_aqui_uma_chave_segura_com_pelo_menos_64_caracteres_hexadecimal
JWT_EXPIRES_IN=2h

# Caminho do banco de dados SQLite
DATABASE_PATH=./cloudos.sqlite
