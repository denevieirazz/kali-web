<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Windows.Graphics.Capture HWND/HMONITOR interop requires Windows 10 1903+.
    Keep TerraFX limited to the D3D11/DXGI binding; capture architecture stays on
    Windows.Graphics.Capture + CsWinRT and does not introduce SharpDX.
  -->
  <ItemGroup>
    <PackageReference Include="TerraFX.Interop.Windows" Version="10.0.26100.1" />
  </ItemGroup>
</Project>
