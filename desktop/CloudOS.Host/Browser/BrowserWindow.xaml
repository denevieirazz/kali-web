<Window x:Class="CloudOS.Host.Browser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navegador CloudOS" Width="1180" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource CloudOsBackground}"
        Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
  <Grid Background="{StaticResource CloudOsBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="True" Background="#0D1525">
      <Button DockPanel.Dock="Right" Width="42" Margin="0,4,4,4" Content="⋯" Click="BrowserMenu_Click" ToolTip="Menu do navegador" />
      <Button DockPanel.Dock="Right" Width="42" Margin="4" Content="+" Click="NewTab_Click" ToolTip="Nova aba (Ctrl+T)" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="6,5" />
      </ScrollViewer>
    </DockPanel>

    <Grid Grid.Row="1" Margin="8,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" />
        <ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" /><ColumnDefinition Width="36" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Grid.Column="0" Content="←" Click="Back_Click" ToolTip="Voltar (Alt+Left)" />
      <Button x:Name="ForwardButton" Grid.Column="1" Content="→" Click="Forward_Click" ToolTip="Avançar (Alt+Right)" />
      <Button x:Name="ReloadStopButton" Grid.Column="2" Content="↻" Click="ReloadStop_Click" ToolTip="Recarregar (Ctrl+R)" />
      <Button Grid.Column="3" Content="⌂" Click="Home_Click" ToolTip="Início" />
      <Border Grid.Column="4" Margin="5,1" CornerRadius="5" Background="#152238" VerticalAlignment="Stretch">
        <TextBlock x:Name="SecurityIndicator" Text="—" Foreground="#AFC0D7" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBox x:Name="AddressBox" Grid.Column="5" Margin="4,0" VerticalContentAlignment="Center"
               KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus" />
      <Button x:Name="FavoriteButton" Grid.Column="6" Content="☆" Click="Favorite_Click" ToolTip="Favoritar" />
      <Button Grid.Column="7" Content="★" Click="Favorites_Click" ToolTip="Favoritos" />
      <Button Grid.Column="8" Content="◴" Click="History_Click" ToolTip="Histórico" />
    </Grid>
    <ProgressBar x:Name="LoadProgress" Grid.Row="1" Height="2" VerticalAlignment="Bottom" Margin="8,0"
                 IsIndeterminate="True" Visibility="Collapsed" />

    <Grid Grid.Row="2">
      <Grid x:Name="WebViewHost" Background="#FFFFFF" />

      <Border x:Name="NewTabPanel" Visibility="Collapsed" Background="#0B1220">
        <StackPanel Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="CloudOS Browser" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Pesquise ou digite um endereço" Foreground="#8FA2BE" FontSize="14" Margin="0,8,0,24" HorizontalAlignment="Center" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Ir" Width="70" Margin="8,0,0,0" Click="NewTabGo_Click" />
            <TextBox x:Name="NewTabSearchBox" Height="42" FontSize="15" Padding="10,7" VerticalContentAlignment="Center" KeyDown="NewTabSearchBox_KeyDown" />
          </DockPanel>
          <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="DuckDuckGo" Margin="5" Padding="16,8" Click="NewTabDuck_Click" />
            <Button Content="Histórico" Margin="5" Padding="16,8" Click="History_Click" />
            <Button Content="Favoritos" Margin="5" Padding="16,8" Click="Favorites_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#101827" Padding="32">
        <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Não foi possível abrir esta página" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="ErrorCodeText" Margin="0,12,0,0" Foreground="#E9A0A0" FontFamily="Consolas" HorizontalAlignment="Center" />
          <TextBlock x:Name="ErrorMessageText" Margin="0,12,0,18" Foreground="#BAC7DA" TextWrapping="Wrap" TextAlignment="Center" />
          <WrapPanel HorizontalAlignment="Center">
            <Button x:Name="RetryButton" Content="Recarregar" Padding="18,8" Margin="0,0,8,0" Click="Retry_Click" />
            <Button Content="Voltar" Padding="18,8" Click="ErrorBack_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border x:Name="LibraryPanel" Visibility="Collapsed" Width="420" HorizontalAlignment="Right" Background="#F5111A2B" BorderBrush="#34507C" BorderThickness="1,0,0,0" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock x:Name="LibraryTitle" Text="Favoritos" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <Button DockPanel.Dock="Right" Content="×" Width="32" Click="CloseLibrary_Click" />
          </DockPanel>
          <TextBox x:Name="LibrarySearchBox" Grid.Row="1" Margin="0,10,0,4" Height="34" Padding="8,5"
                   TextChanged="LibrarySearchBox_TextChanged" ToolTip="Buscar" />
          <ListBox x:Name="LibraryList" Grid.Row="2" Margin="0,6" MouseDoubleClick="LibraryList_DoubleClick" />
          <Button x:Name="ClearHistoryButton" Grid.Row="3" Content="Limpar histórico" Visibility="Collapsed" Click="ClearHistory_Click" />
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Background="#0D1525" LastChildFill="True">
      <Button x:Name="CancelDownloadsButton" DockPanel.Dock="Right" Margin="6,3" Padding="10,2"
              Content="Cancelar downloads" Visibility="Collapsed" Click="CancelDownloads_Click" />
      <TextBlock x:Name="ZoomStatusText" DockPanel.Dock="Right" Margin="6,7" Foreground="#8FA2BE" FontSize="11" Text="100%" />
      <TextBlock x:Name="StatusText" Margin="10,7" Foreground="#8FA2BE" FontSize="11" Text="Pronto" />
    </DockPanel>
  </Grid>
</Window>
