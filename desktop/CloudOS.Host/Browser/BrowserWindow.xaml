<Window x:Class="CloudOS.Host.Browser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navegador CloudOS"
        Width="1280" Height="820" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrowserWindowBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource BrowserTextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="BrowserWindowVisual_Loaded"
        Activated="BrowserWindowVisual_Activated"
        SizeChanged="BrowserWindowVisual_SizeChanged"
        LayoutUpdated="BrowserWindowVisual_LayoutUpdated">
  <Window.Resources>
    <!-- Default dark palette. BrowserWindow.Visual.cs replaces these brushes for light/system mode. -->
    <SolidColorBrush x:Key="BrowserWindowBrush" Color="#08111F" />
    <SolidColorBrush x:Key="BrowserChromeBrush" Color="#0D1726" />
    <SolidColorBrush x:Key="BrowserSurfaceBrush" Color="#142238" />
    <SolidColorBrush x:Key="BrowserSurfaceAltBrush" Color="#101B2D" />
    <SolidColorBrush x:Key="BrowserSurfaceHoverBrush" Color="#1B2C46" />
    <SolidColorBrush x:Key="BrowserSurfacePressedBrush" Color="#223653" />
    <SolidColorBrush x:Key="BrowserActiveTabBrush" Color="#1A2A43" />
    <SolidColorBrush x:Key="BrowserInactiveTabBrush" Color="#0D1726" />
    <SolidColorBrush x:Key="BrowserBorderBrush" Color="#263A56" />
    <SolidColorBrush x:Key="BrowserTextPrimaryBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="BrowserTextSecondaryBrush" Color="#BAC8DA" />
    <SolidColorBrush x:Key="BrowserTextMutedBrush" Color="#8092A8" />
    <SolidColorBrush x:Key="BrowserAccentBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="BrowserAccentHoverBrush" Color="#6DA2FF" />
    <SolidColorBrush x:Key="BrowserDangerBrush" Color="#FF6B7A" />
    <SolidColorBrush x:Key="BrowserSuccessBrush" Color="#5FD39B" />
    <SolidColorBrush x:Key="BrowserInputBrush" Color="#0B1524" />

    <Style x:Key="ChromeIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="9" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrowserSurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrowserSurfacePressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.34" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeIconButtonStyle}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Background" Value="{DynamicResource BrowserAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrowserAccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Background" Value="{DynamicResource BrowserSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrowserBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrowserSurfaceHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrowserSurfacePressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource BrowserInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrowserBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="SelectionBrush" Value="{DynamicResource BrowserAccentBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrowserAccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AddressTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="SelectionBrush" Value="{DynamicResource BrowserAccentBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabSelectButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="108" />
      <Setter Property="MaxWidth" Value="210" />
      <Setter Property="Padding" Value="12,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource BrowserInactiveTabBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrowserBorderBrush}" />
      <Setter Property="BorderThickness" Value="1,1,0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9,0,0,9">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrowserSurfaceHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrowserSurfacePressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabCloseButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="9" />
      <Setter Property="Background" Value="{DynamicResource BrowserInactiveTabBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrowserBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,1,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0,9,9,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#33FF6B7A" />
                <Setter Property="Foreground" Value="{DynamicResource BrowserDangerBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#55FF6B7A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource BrowserSurfaceBrush}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrowserSurfaceHoverBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrowserSurfacePressedBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource BrowserTextPrimaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Background="{DynamicResource BrowserWindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>

    <!-- Tab strip -->
    <Border Grid.Row="0"
            Background="{DynamicResource BrowserChromeBrush}"
            BorderBrush="{DynamicResource BrowserBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,7,8,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="BrandBadge"
                Grid.Column="0"
                Margin="2,0,10,0"
                Padding="9,0"
                Height="36"
                CornerRadius="9"
                Background="{DynamicResource BrowserSurfaceAltBrush}"
                BorderBrush="{DynamicResource BrowserBorderBrush}"
                BorderThickness="1">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrowserAccentBrush}">
              <TextBlock Text="C" Foreground="White" FontSize="11" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="CloudOS Browser" Margin="7,0,0,0"
                       Foreground="{DynamicResource BrowserTextSecondaryBrush}"
                       FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <ScrollViewer x:Name="TabScroll"
                      Grid.Column="1"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="TabScroll_PreviewMouseWheel">
          <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
        </ScrollViewer>

        <Button Grid.Column="2"
                Style="{StaticResource ChromeIconButtonStyle}"
                Margin="6,0,2,0"
                Click="NewTab_Click"
                ToolTip="Nova aba (Ctrl+T)">
          <Path Width="16" Height="16" Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                StrokeThickness="1.8"
                Data="M8,1 L8,15 M1,8 L15,8" />
        </Button>

        <Button x:Name="ThemeButton"
                Grid.Column="3"
                Style="{StaticResource ChromeIconButtonStyle}"
                Click="ThemeButton_Click"
                ToolTip="Tema do navegador">
          <Path Width="17" Height="17" Stretch="Uniform"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                Data="M8.5,1 A7.5,7.5 0 1 0 8.5,16 A5.7,5.7 0 0 1 8.5,1 Z" />
        </Button>

        <Button Grid.Column="4"
                Style="{StaticResource ChromeIconButtonStyle}"
                Click="BrowserMenu_Click"
                ToolTip="Menu do navegador">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="3" Height="3" Margin="1.5,0"
                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            <Ellipse Width="3" Height="3" Margin="1.5,0"
                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            <Ellipse Width="3" Height="3" Margin="1.5,0"
                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Navigation and integrated address bar -->
    <Border Grid.Row="1"
            Background="{DynamicResource BrowserChromeBrush}"
            BorderBrush="{DynamicResource BrowserBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Style="{StaticResource ChromeIconButtonStyle}" Click="Back_Click" ToolTip="Voltar (Alt+Left)">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M10.5,2 L4.5,8 L10.5,14 M5,8 L15,8" />
          </Button>
          <Button x:Name="ForwardButton" Style="{StaticResource ChromeIconButtonStyle}" Click="Forward_Click" ToolTip="Avançar (Alt+Right)">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M5.5,2 L11.5,8 L5.5,14 M11,8 L1,8" />
          </Button>
          <Button x:Name="ReloadStopButton" Style="{StaticResource ChromeIconButtonStyle}" Click="ReloadStop_Click" ToolTip="Recarregar (Ctrl+R)">
            <Path Width="17" Height="17" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M13.5,5.3 A6,6 0 1 0 14,10 M13.5,2.2 L13.5,5.4 L10.3,5.4" />
          </Button>
          <Button x:Name="HomeButton" Style="{StaticResource ChromeIconButtonStyle}" Click="Home_Click" ToolTip="Início">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.65" StrokeLineJoin="Round"
                  Data="M2,7.2 L8,2 L14,7.2 M4,6.2 L4,14 L12,14 L12,6.2 M6.5,14 L6.5,9.5 L9.5,9.5 L9.5,14" />
          </Button>
        </StackPanel>

        <Border x:Name="AddressShell"
                Grid.Column="1"
                Height="40"
                Margin="8,0"
                Padding="8,0,4,0"
                CornerRadius="10"
                Background="{DynamicResource BrowserInputBrush}"
                BorderBrush="{DynamicResource BrowserBorderBrush}"
                BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,5,8,5"
                    Padding="7,0"
                    CornerRadius="7"
                    Background="{DynamicResource BrowserSurfaceAltBrush}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="SecurityIcon"
                      Width="12" Height="12" Stretch="Uniform"
                      Stroke="{DynamicResource BrowserTextMutedBrush}"
                      StrokeThickness="1.5"
                      Data="M3,7 L3,4.8 A3,3 0 0 1 9,4.8 L9,7 M2,7 L10,7 L10,13 L2,13 Z M6,9.4 L6,11" />
                <TextBlock x:Name="SecurityIndicator"
                           Text="—"
                           Margin="5,0,0,0"
                           Foreground="{DynamicResource BrowserTextMutedBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <TextBox x:Name="AddressBox"
                     Grid.Column="1"
                     Style="{StaticResource AddressTextBoxStyle}"
                     KeyDown="AddressBox_KeyDown"
                     GotKeyboardFocus="AddressBox_GotKeyboardFocus" />

            <Button x:Name="FavoriteButton"
                    Grid.Column="2"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Width="32" Height="32"
                    Margin="2,0,0,0"
                    Click="Favorite_Click"
                    ToolTip="Favoritar">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.5"
                    StrokeLineJoin="Round"
                    Data="M8,1.4 L10,5.3 L14.4,5.9 L11.2,9 L12,13.5 L8,11.4 L4,13.5 L4.8,9 L1.6,5.9 L6,5.3 Z" />
            </Button>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FavoritesToolbarButton"
                  Style="{StaticResource ChromeIconButtonStyle}"
                  Click="Favorites_Click"
                  ToolTip="Favoritos">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.55" StrokeLineJoin="Round"
                  Data="M8,1.4 L10,5.3 L14.4,5.9 L11.2,9 L12,13.5 L8,11.4 L4,13.5 L4.8,9 L1.6,5.9 L6,5.3 Z" />
          </Button>
          <Button x:Name="HistoryToolbarButton"
                  Style="{StaticResource ChromeIconButtonStyle}"
                  Click="History_Click"
                  ToolTip="Histórico">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M3,4 L3,1.5 M3,4 L5.5,4 M3.2,4.1 A6.2,6.2 0 1 1 2,9 M8,4.5 L8,8 L10.7,9.6" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <ProgressBar x:Name="LoadProgress"
                 Grid.Row="1"
                 Height="2"
                 VerticalAlignment="Bottom"
                 IsIndeterminate="True"
                 Foreground="{DynamicResource BrowserAccentBrush}"
                 Background="Transparent"
                 Visibility="Collapsed" />

    <!-- Content. WebViewHost remains the real WebView2 host; panels are shown only for internal browser states. -->
    <Grid Grid.Row="2" Background="{DynamicResource BrowserWindowBrush}">
      <Grid x:Name="WebViewHost" Background="White" />

      <Border x:Name="NewTabPanel" Visibility="Collapsed" Background="{DynamicResource BrowserWindowBrush}">
        <Grid Margin="28">
          <Border MaxWidth="760"
                  Padding="46,42"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource BrowserSurfaceAltBrush}"
                  BorderBrush="{DynamicResource BrowserBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="22">
            <StackPanel>
              <Border Width="52" Height="52" CornerRadius="16"
                      Background="{DynamicResource BrowserAccentBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="C" Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="CloudOS Browser"
                         Margin="0,18,0,0"
                         Foreground="{DynamicResource BrowserTextPrimaryBrush}"
                         FontSize="30" FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Pesquise na web ou digite um endereço"
                         Margin="0,7,0,24"
                         Foreground="{DynamicResource BrowserTextMutedBrush}"
                         FontSize="14"
                         HorizontalAlignment="Center" />

              <Grid MaxWidth="620" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTabSearchBox"
                         Grid.Column="0"
                         Style="{StaticResource ChromeTextBoxStyle}"
                         Height="44"
                         KeyDown="NewTabSearchBox_KeyDown" />
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44" MinWidth="72"
                        Margin="8,0,0,0"
                        Content="Ir"
                        Click="NewTabGo_Click" />
              </Grid>

              <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="DuckDuckGo" Margin="4" Click="NewTabDuck_Click" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Histórico" Margin="4" Click="History_Click" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Favoritos" Margin="4" Click="Favorites_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="{DynamicResource BrowserWindowBrush}">
        <Border MaxWidth="620"
                Padding="38" Margin="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource BrowserSurfaceAltBrush}"
                BorderBrush="{DynamicResource BrowserBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
          <StackPanel>
            <Border Width="48" Height="48" CornerRadius="14" Background="#22FF6B7A" HorizontalAlignment="Center">
              <Path Width="22" Height="22" Stretch="Uniform"
                    Stroke="{DynamicResource BrowserDangerBrush}"
                    StrokeThickness="1.8"
                    Data="M8,1 L15,14 L1,14 Z M8,5 L8,9 M8,11.5 L8,12" />
            </Border>
            <TextBlock Text="Não foi possível abrir esta página"
                       Margin="0,18,0,0"
                       Foreground="{DynamicResource BrowserTextPrimaryBrush}"
                       FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorCodeText"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource BrowserDangerBrush}"
                       FontFamily="Consolas" FontSize="12"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ErrorMessageText"
                       Margin="0,10,0,20"
                       Foreground="{DynamicResource BrowserTextSecondaryBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <WrapPanel HorizontalAlignment="Center">
              <Button x:Name="RetryButton" Style="{StaticResource PrimaryButtonStyle}"
                      Content="Recarregar" Margin="0,0,8,0" Click="Retry_Click" />
              <Button Style="{StaticResource SecondaryButtonStyle}" Content="Voltar" Click="ErrorBack_Click" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Border>

      <Border x:Name="LibraryPanel"
              Visibility="Collapsed"
              Width="390" MinWidth="300" MaxWidth="430"
              HorizontalAlignment="Right"
              Background="{DynamicResource BrowserSurfaceAltBrush}"
              BorderBrush="{DynamicResource BrowserBorderBrush}"
              BorderThickness="1,0,0,0"
              Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="LibraryTitle" Text="Favoritos"
                         Foreground="{DynamicResource BrowserTextPrimaryBrush}"
                         FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="Biblioteca do navegador" Margin="0,3,0,0"
                         Foreground="{DynamicResource BrowserTextMutedBrush}" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource ChromeIconButtonStyle}"
                    Width="32" Height="32"
                    Click="CloseLibrary_Click" ToolTip="Fechar">
              <Path Width="13" Height="13" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.8"
                    Data="M2,2 L12,12 M12,2 L2,12" />
            </Button>
          </Grid>

          <TextBox x:Name="LibrarySearchBox"
                   Grid.Row="1"
                   Style="{StaticResource ChromeTextBoxStyle}"
                   Height="40" Margin="0,16,0,8"
                   TextChanged="LibrarySearchBox_TextChanged"
                   ToolTip="Buscar" />

          <ListBox x:Name="LibraryList"
                   Grid.Row="2"
                   Margin="0,4,0,8"
                   MouseDoubleClick="LibraryList_DoubleClick" />

          <Button x:Name="ClearHistoryButton"
                  Grid.Row="3"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Content="Limpar histórico"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  Click="ClearHistory_Click" />
        </Grid>
      </Border>
    </Grid>

    <!-- Compact status bar -->
    <Border Grid.Row="3"
            Background="{DynamicResource BrowserChromeBrush}"
            BorderBrush="{DynamicResource BrowserBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="StatusText"
                   Grid.Column="0"
                   Text="Pronto"
                   Foreground="{DynamicResource BrowserTextMutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="LoadingStatusText"
                   Grid.Column="1"
                   Text="Carregando…"
                   Margin="8,0"
                   Foreground="{DynamicResource BrowserAccentBrush}"
                   FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Visibility="Collapsed" />

        <TextBlock x:Name="ZoomStatusText"
                   Grid.Column="2"
                   Margin="8,0"
                   Foreground="{DynamicResource BrowserTextMutedBrush}"
                   FontSize="11"
                   Text="100%"
                   VerticalAlignment="Center" />

        <Button x:Name="CancelDownloadsButton"
                Grid.Column="3"
                Style="{StaticResource ChromeToolbarButtonStyle}"
                Height="24"
                Margin="4,0,0,0"
                Padding="8,2"
                Content="Cancelar downloads"
                Visibility="Collapsed"
                Click="CancelDownloads_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
