<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>CloudOS.Host</RootNamespace>
    <AssemblyName>CloudOS.Host</AssemblyName>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <WebView2PackageVersion>1.0.4078.44</WebView2PackageVersion>
    <CloudOSNativeRuntimeBuildScript>$(MSBuildProjectDirectory)\..\..\scripts\native\build-native-runtime.ps1</CloudOSNativeRuntimeBuildScript>
    <CloudOSNativeRuntimeOutput>$(MSBuildProjectDirectory)\..\CloudOS.NativeRuntime\bin\$(Configuration)\CloudOS.NativeRuntime.dll</CloudOSNativeRuntimeOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2PackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudOS.Installer\CloudOS.Installer.csproj" />
  </ItemGroup>

  <Target Name="BuildCloudOSNativeRuntime" BeforeTargets="CoreCompile" Condition="'$(OS)' == 'Windows_NT' and Exists('$(CloudOSNativeRuntimeBuildScript)')">
    <Exec Command="pwsh.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(CloudOSNativeRuntimeBuildScript)&quot; -Configuration &quot;$(Configuration)&quot; -OutputDirectory &quot;$(TargetDir)&quot;" />
  </Target>

  <Target Name="CopyCloudOSNativeRuntimeToPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' and Exists('$(CloudOSNativeRuntimeOutput)')">
    <Copy SourceFiles="$(CloudOSNativeRuntimeOutput)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
