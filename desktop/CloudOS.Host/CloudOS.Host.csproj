<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>CloudOS.Host</RootNamespace>
    <AssemblyName>CloudOS.Host</AssemblyName>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <WebView2PackageVersion>1.0.4078.44</WebView2PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2PackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudOS.WindowsCapture\CloudOS.WindowsCapture.csproj" />
    <ProjectReference Include="..\CloudOS.WindowsCapture.Presenter\CloudOS.WindowsCapture.Presenter.csproj" />
  </ItemGroup>
</Project>
